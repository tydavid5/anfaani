# Environment variables. Copy to .env for local use. Never commit a real .env.
# No real keys exist in this repo.

# Required to send real alert emails. Leave blank to run without email.
# Create a free Resend account at https://resend.com, create an API key,
# and set it here. The user must create this key, it is not in the repo.
RESEND_API_KEY=
FROM_EMAIL=

# Optional. Defaults shown.
PORT=3000
DATA_DIR=./data
